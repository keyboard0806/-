      }

      return {
        mainBook, mainReason, mainBadge, mainDuration, mainLevel,
        subBook, subReason, subBadge, subUsage, subLevel
      };
    }

    // -------------------------------------------------------------
    // 4. UI SCREEN TRANSITIONS & INTERACTION LOGIC
    // -------------------------------------------------------------
    
    function startDiagnostic() {
      document.getElementById('screen-welcome').classList.add('hidden');
      document.getElementById('screen-diagnostic').classList.remove('hidden');
      currentStep = 1;
      renderQuestion();
    }

    function resetToStart() {
      currentStep = 1;
      userAnswers = { level: '', gradeStr: '', objective: '', confidence: '', bottleneck: '', style: '', volume: '', answerKey: '' };
      document.getElementById('screen-result').classList.add('hidden');
      document.getElementById('screen-diagnostic').classList.add('hidden');
      document.getElementById('screen-loading').classList.add('hidden');
      document.getElementById('screen-welcome').classList.remove('hidden');
    }

    function renderQuestion() {
      const q = questions[currentStep - 1];
      
      // Update Step Header
      document.getElementById('step-indicator').innerText = `Step ${currentStep} of ${TOTAL_STEPS}`;
      document.getElementById('step-category').innerText = q.category;
      
      // Update Progress Bar %
      const progressPercent = Math.round((currentStep / TOTAL_STEPS) * 100);
      document.getElementById('progress-bar').style.width = `${progressPercent}%`;

      // Update Question Titles
      document.getElementById('q-title').innerText = q.title;
      document.getElementById('q-subtitle').innerText = q.subtitle;

      // Render Options
      const optionsContainer = document.getElementById('q-options');
      optionsContainer.innerHTML = '';

      q.options.forEach((opt, idx) => {
        const optBtn = document.createElement('button');
        optBtn.className = `card-option w-full text-left p-4 rounded-xl border border-slate-200 hover:border-blue-500 hover:bg-blue-50/50 bg-white transition-all flex items-start justify-between group`;
        
        let subText = opt.desc ? `<p class="text-xs text-slate-500 mt-1">${opt.desc}</p>` : '';
        
        optBtn.innerHTML = `
          <div class="pr-3">
            <span class="font-bold text-slate-800 text-sm group-hover:text-blue-700 block">${opt.label}</span>
            ${subText}
          </div>
          <div class="w-5 h-5 rounded-full border border-slate-300 group-hover:border-blue-600 group-hover:bg-blue-600 flex items-center justify-center text-white text-xs mt-0.5 transition-colors">
            <i data-lucide="check" class="w-3 h-3 opacity-0 group-hover:opacity-100"></i>
          </div>
        `;

        optBtn.onclick = () => handleOptionSelect(opt);
        optionsContainer.appendChild(optBtn);
      });

      // Update Prev Button State
      const prevBtn = document.getElementById('btn-prev');
      if (currentStep === 1) {
        prevBtn.disabled = true;
      } else {
        prevBtn.disabled = false;
      }

      // Refresh icons for dynamic content
      lucide.createIcons();
    }

    function handleOptionSelect(opt) {
      // Record answer according to current step
      switch (currentStep) {
        case 1:
          userAnswers.level = opt.level;
          userAnswers.gradeStr = opt.label;
          break;
        case 2:
          userAnswers.objective = opt.value;
          break;
        case 3:
          userAnswers.confidence = opt.value;
          break;
        case 4:
          userAnswers.bottleneck = opt.value;
          break;
        case 5:
          userAnswers.style = opt.value;
          break;
        case 6:
          userAnswers.volume = opt.value;
          break;
        case 7:
          userAnswers.answerKey = opt.value;
          break;
      }

      if (currentStep < TOTAL_STEPS) {
        currentStep++;
        renderQuestion();
      } else {
        // All steps completed -> Show Loading then Result
        showLoadingAndProcess();
      }
    }

    function handlePrevStep() {
      if (currentStep > 1) {
        currentStep--;
        renderQuestion();
      }
    }

    // -------------------------------------------------------------
    // 5. RESULT DISPLAY & CUSTOMIZATION
    // -------------------------------------------------------------
    function showLoadingAndProcess() {
      document.getElementById('screen-diagnostic').classList.add('hidden');
      document.getElementById('screen-loading').classList.remove('hidden');

      setTimeout(() => {
        document.getElementById('screen-loading').classList.add('hidden');
        renderFinalResult();
        document.getElementById('screen-result').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 1200);
    }

    function renderFinalResult() {
      const rec = calculateRecommendation(userAnswers);

      // Result Headline & Summary
      document.getElementById('result-headline').innerText = `[${userAnswers.gradeStr}] 맞춤 교재 진단 솔루션`;
      
      let summaryStr = `${userAnswers.gradeStr} 학생의 진단 결과, 현재 실력 수준과 ${getObjectiveText(userAnswers.objective)} 목표를 고려할 때 `;
      summaryStr += `가장 큰 학습 걸림돌인 '${getBottleneckText(userAnswers.bottleneck)}'을 해결할 수 있는 맞춤 조합으로 구성했습니다.`;
      document.getElementById('result-summary-text').innerText = summaryStr;

      // Result Tag Chips
      const tagsContainer = document.getElementById('result-tags');
      tagsContainer.innerHTML = `
        <span class="text-xs bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full">${userAnswers.gradeStr}</span>
        <span class="text-xs bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full">목표: ${getObjectiveText(userAnswers.objective)}</span>
        <span class="text-xs bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full">취약점: ${getBottleneckText(userAnswers.bottleneck)}</span>
      `;

      // Main Book Fill
      document.getElementById('main-book-badge').innerText = rec.mainBadge;
      document.getElementById('main-book-title').innerText = rec.mainBook;
      document.getElementById('main-book-reason').innerText = rec.mainReason;
      document.getElementById('main-book-duration').innerText = rec.mainDuration;
      document.getElementById('main-book-level').innerText = `난이도: ${rec.mainLevel}`;

      // Sub Book Fill
      document.getElementById('sub-book-badge').innerText = rec.subBadge;
      document.getElementById('sub-book-title').innerText = rec.subBook;
      document.getElementById('sub-book-reason').innerText = rec.subReason;
      document.getElementById('sub-book-level').innerText = `난이도: ${rec.subLevel}`;

      // Roadmap Step Customization based on Answer Key & Style
      if (userAnswers.answerKey === 'fast') {
        document.getElementById('roadmap-step3').innerText = "제공된 빠른 정답표로 채점 시간을 단축하고, 오답 해설만 발췌독하세요.";
      } else if (userAnswers.answerKey === 'detailed') {
        document.getElementById('roadmap-step3').innerText = "틀린 문제는 해설지의 줄글 설명과 다양한 접근 풀이법을 정독하세요.";
      } else {
        document.getElementById('roadmap-step3').innerText = "출제 의도와 킬러 문항 분석 팁을 참고하여 오답 노트 원인을 기록하세요.";
      }

      // Timestamp
      const now = new Date();
      document.getElementById('result-timestamp').innerText = `${now.getFullYear()}.${now.getMonth()+1}.${now.getDate()} 진단`;

      lucide.createIcons();
    }

    // Helper text convertors
    function getObjectiveText(code) {
      switch(code) {
        case 'preview': return '선행·예습';
        case 'review': return '복습·내신';
        case 'vacation': return '방학 개념완성';
        case 'weakness': return '취약 보완';
        default: return '학습';
      }
    }

    function getBottleneckText(code) {
      switch(code) {
        case 'concept': return '개념 이해 부족';
        case 'mistake': return '계산/실수 보완';
        case 'speed': return '풀이 속도 향상';
        case 'application': return '고난도 응용력';
        default: return '실력 향상';
      }
    }

    // Copy Results function
    function copyResults() {
      const mainTitle = document.getElementById('main-book-title').innerText;
      const subTitle = document.getElementById('sub-book-title').innerText;
      const summary = document.getElementById('result-summary-text').innerText;

      const clipText = `[MathLab 수학 교재 진단 결과]\n\n● 대상: ${userAnswers.gradeStr}\n● 메인 교재: ${mainTitle}\n● 서브 교재: ${subTitle}\n\n● 진단 요약: ${summary}\n\nMathLab 엔진에서 맞춤 분석되었습니다.`;

      // Copy using document.execCommand for iFrame compatibility
      const dummy = document.createElement("textarea");
      document.body.appendChild(dummy);
      dummy.value = clipText;
      dummy.select();
      document.execCommand("copy");
      document.body.removeChild(dummy);

      alert("진단 결과가 클립보드에 복사되었습니다. KakaoTalk이나 메모장에 붙여넣기 하세요!");
    }

    // Initialize Lucide Icons on Load
    window.onload = function() {
      lucide.createIcons();
    };
  </script>
</body>
</html>
