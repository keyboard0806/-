              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-400">보완 역할: 개념 단단히 하기</span>
            <span id="sub-book-level" class="text-xs font-semibold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">난이도: 기본</span>
          </div>
        </div>

      </div>

      <!-- 4-STEP STUDY ROADMAP -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xl p-6 sm:p-8">
        <div class="flex items-center space-x-2 mb-6">
