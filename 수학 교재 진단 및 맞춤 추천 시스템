    // 1. DIAGNOSTIC DATA & STATE MANAGEMENT
    // -------------------------------------------------------------
    
    // User Answers Object
    let userAnswers = {
      level: '',        // 'elem', 'mid', 'high'
      gradeStr: '',     // e.g., '초등 5학년'
      objective: '',    // 'preview', 'review', 'vacation', 'weakness'
      confidence: '',   // 'low', 'mid_low', 'mid', 'high'
      bottleneck: '',   // 'concept', 'mistake', 'speed', 'application'
