        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-6 relative flex flex-col justify-between">
          <div class="absolute -top-3.5 left-6 bg-slate-800 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md flex items-center space-x-1">
