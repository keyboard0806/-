            mainReason = "내신 기출, 서술형, 모의고사 기출까지 압도적 문제량으로 2~3등급 도약에 최고입니다.";
            mainLevel = "유형~응용";

            subBook = "개념원리";
            subBadge = "원리 재확인";
            subReason = "문제량이 많아 막힐 때 공식 증명과 기본 개념을 찾아보는 바이블 역할입니다.";
          } else {
            mainBook = "쎈 (Cen) 고등 수학";
            mainBadge = "고등 내신 필독서";
            mainReason = "전국 고교 내신 기출 유형이 빈틈없이 다루어져 있어 내신 대비에 가장 안정적입니다.";
            mainLevel = "유형~응용";

            subBook = "개념원리 RPM";
            subBadge = "기초 회독";
            subReason = "쎈 문제 풀이가 살짝 버거울 때 기초 B단계 문제 위주로 서브 연습하세요.";
          }
        } else if (ans.confidence === 'mid_low') {
          if (ans.objective === 'preview' || ans.volume === 'thin') {
            mainBook = "개념+유형 고등 수학";
            mainBadge = "빠른 진도/개념 정리";
            mainReason = "고등 수학의 방대한 진도를 부담 없이 빠르게 끝내고 개념틀을 완성하기 좋습니다.";
            mainLevel = "개념~유형";

            subBook = "개념원리 RPM";
            subBadge = "기본 유형";
            subReason = "진도를 나간 후 기본 유형 유지를 위한 연습 문제집으로 활용하세요.";
          } else {
            mainBook = "개념원리 RPM 고등 수학";
