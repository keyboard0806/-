        </div>
        <div class="flex items-center space-x-2 text-blue-600 font-medium animate-pulse">
          <i data-lucide="loader" class="w-3.5 h-3.5 animate-spin"></i>
          <span>최적의 메인 교재 + 서브 교재 매칭 중</span>
        </div>
      </div>
    </section>

    <!-- RESULT PRESENTATION SCREEN -->
    <section id="screen-result" class="hidden fade-enter fade-enter-active space-y-6">
      
      <!-- Top Diagnostic Summary Banner -->
      <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
